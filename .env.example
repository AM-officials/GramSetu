# GramSetu Environment Variables
# Copy this file to .env and fill in your values

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=gramsetu_dev
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# AWS (will be populated once account is verified)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# DynamoDB (local mock)
DYNAMODB_TABLE_CONVERSATIONS=gramsetu-conversations

# S3 (local mock — uses ./storage/ directory)
S3_BUCKET_NAME=gramsetu-storage
LOCAL_STORAGE_PATH=./storage

# App
APP_ENV=development
LOG_LEVEL=INFO
